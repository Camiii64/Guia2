<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MiPerfil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/rose_mist</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="colorPrimary">@color/mauve</item>
        <item name="colorSecondary">@color/sage</item>
        <item name="colorError">@color/error_soft</item>
    </style>

    <style name="Theme.MiPerfil" parent="Base.Theme.MiPerfil" />

    <style name="ProfileSummaryText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/plum_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
