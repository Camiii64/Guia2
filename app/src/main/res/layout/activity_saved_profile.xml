<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfil guardado"
            android:textColor="@color/plum_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvResumenNombre"
                style="@style/ProfileSummaryText" />

            <TextView
                android:id="@+id/tvResumenCorreo"
                style="@style/ProfileSummaryText" />

            <TextView
                android:id="@+id/tvResumenTelefono"
                style="@style/ProfileSummaryText" />

            <TextView
                android:id="@+id/tvResumenFecha"
                style="@style/ProfileSummaryText" />

            <TextView
                android:id="@+id/tvResumenDireccion"
                style="@style/ProfileSummaryText" />

            <TextView
                android:id="@+id/tvResumenCamara"
                style="@style/ProfileSummaryText" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevoPerfil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Nuevo perfil"
            android:textAllCaps="false"
            app:backgroundTint="@color/sage"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegresarInicio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Regresar al inicio"
            android:textAllCaps="false"
            app:backgroundTint="@color/mauve"
            app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
